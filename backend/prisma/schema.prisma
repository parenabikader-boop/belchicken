// Belchicken · Phase 1 : commande en ligne
// Montants en FCFA (entiers). Fuseau de référence : Africa/Ouagadougou (UTC+0).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // URL poolée Neon
  directUrl = env("DIRECT_URL") // URL directe Neon (migrations)
}

// ─────────────────────────── ENUMS ───────────────────────────

// Parcours : PAIEMENT_A_VERIFIER -> PAYEE -> EN_PREPARATION -> EN_LIVRAISON -> LIVREE,
// ANNULEE possible à tout moment avant LIVREE. PAYEE est toujours posé à la main par l'équipe,
// après vérification sur le téléphone marchand. Règles dans src/services/order-status.js.
enum OrderStatus {
  PAIEMENT_A_VERIFIER // départ de toute nouvelle commande
  PAYEE
  EN_PREPARATION
  EN_LIVRAISON
  LIVREE // livrée, ou retirée au comptoir pour une commande à emporter
  ANNULEE
  PRETE // à emporter : prête, le client peut venir la retirer
}

// Livraison à domicile, ou commande à emporter (retirée au restaurant, sans frais ni livreur)
enum FulfillmentMode {
  LIVRAISON
  A_EMPORTER
}

enum PaymentMethod {
  ORANGE_MONEY
  MOOV_MONEY
  ESPECES // refusé par l'API (plus d'espèces pour les plats), gardé pour les anciennes commandes
  TELECEL_MONEY
}

// D'où viennent les frais de livraison d'une commande
enum DeliveryFeeSource {
  QUARTIER // prix du quartier choisi par le client (grille du Patron)
  DISTANCE // tranche de distance depuis le restaurant (position GPS du client)
  A_CONFIRMER // autre quartier, au-delà de la dernière tranche ou position imprécise : l'agent fixe les frais au téléphone
  AGENT // saisis ou corrigés par l'équipe
}

// Frais de livraison payés au livreur à la réception : comment le client les a payés
enum FeePaymentMethod {
  ESPECES // en espèces au livreur (remises ensuite au restaurant : CashRemittance)
  MOBILE_MONEY // par Orange Money / Moov Money / Telecel Money, code marchand (vérifiés par l'équipe)
}

enum NotificationStatus {
  ENVOYEE
  ECHEC
  IGNOREE // WhatsApp non configuré
}

// ─────────────────────────── MENU ───────────────────────────

model Category {
  id                String      @id @default(cuid())
  slug              String      @unique
  name              String
  description       String?
  script            String? // petit titre du bandeau, ex. "Originals & XL"
  heroImageUrl      String? // photo vedette du bandeau (Cloudinary, ou /menu/… pour les photos d'origine)
  heroImagePublicId String? // identifiant Cloudinary, pour remplacer ou supprimer la photo
  position          Int         @default(0)
  isActive          Boolean     @default(true)
  // Catégorie « Boissons » (une seule) : ses plats sont les boissons à choisir dans les formules,
  // et se vendent aussi seules au prix normal
  isDrinks          Boolean     @default(false)
  groups            MenuGroup[]
  products          Product[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

// Sous-groupe d'une catégorie (ex. Burgers › Originals, XL, Bœuf)
model MenuGroup {
  id         String    @id @default(cuid())
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String
  note       String? // ex. "N° 7 à 9"
  position   Int       @default(0)
  products   Product[]

  @@unique([categoryId, name])
}

model Product {
  id            String           @id @default(cuid())
  slug          String           @unique
  number        Int? // numéro du menu papier (N° 7…)
  name          String
  description   String?
  composition   String[] // ce qui est inclus dans une formule
  imageUrl      String?
  imagePublicId String? // identifiant Cloudinary de imageUrl (vide pour les photos d'origine)
  isSpicy       Boolean          @default(false)
  serves        String? // "2 personnes"
  choiceLabel   String? // ex. "Cuisson du poulet"
  choices       String[] // ex. ["Grillé", "Frit"]
  isAvailable   Boolean          @default(true)
  // Plat retiré du menu alors qu'il a déjà été commandé : on le garde pour l'historique des commandes.
  // Un plat jamais commandé est vraiment supprimé.
  archivedAt    DateTime?
  position      Int              @default(0)
  categoryId    String
  category      Category         @relation(fields: [categoryId], references: [id])
  groupId       String?
  group         MenuGroup?       @relation(fields: [groupId], references: [id], onDelete: SetNull)
  variants      ProductVariant[]
  orderItems    OrderItem[]
  drinkChoices  OrderItemDrink[] // boisson choisie dans des formules
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([categoryId])
}

// Tout produit a au moins une variante : c'est elle qui porte le prix
// (Menu / Seul, Taille L / XL, 4 pièces / 8 pièces, ou "standard").
model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  code       String // "menu", "seul", "L", "4pc", "standard"
  label      String
  subLabel   String?
  price      Int
  // Boissons incluses, au choix du client parmi les boissons disponibles, sans supplément
  // (Menu = 1, Friends Bucket = 2, Family Bucket = 4, Seul = 0). Modifiable par le Patron.
  drinkCount Int         @default(0)
  position   Int         @default(0)
  orderItems OrderItem[]

  @@unique([productId, code])
}

// Réglages du logiciel : une seule ligne (id = 1), créée au premier enregistrement. Pas de ligne = tout
// éteint (la migration n'écrit rien). Chaque nouveauté de la feuille de route (docs/feuille-de-route.md)
// y ajoute son interrupteur, éteint par défaut.
model AppSettings {
  id            Int      @id @default(1)
  shortFlow     Boolean  @default(false) // parcours court : « Paiement vérifié » -> En préparation, un seul message
  agentOrders   Boolean  @default(false) // lot 2 : prise de commande par l'agent (appel, WhatsApp)
  updatedByName String? // dernier à avoir changé un réglage (copie figée)
  updatedAt     DateTime @updatedAt
}

// ─── Provenance des commandes (lot 2, src/services/order-sources.js) ───

enum OrderSourceKind {
  SITE // commandes passées sur le site : jamais proposée à l'agent, ni supprimable ni désactivable
  APPEL
  WHATSAPP // phone = numéro WhatsApp depuis lequel l'agent écrit au client
  AUTRE
}

// Provenances réglables par le Patron. La migration crée Site, Appel et les deux WhatsApp (si absentes).
// Jamais supprimées une fois utilisées, seulement désactivées : les commandes gardent le nom copié.
model OrderSource {
  id        String          @id @default(cuid())
  name      String          @unique // « Appel », « WhatsApp +226 05 23 48 48 »…
  kind      OrderSourceKind
  phone     String? // WHATSAPP : numéro (+226XXXXXXXX) depuis lequel écrire au client
  position  Int             @default(0) // ordre dans la liste de l'agent
  isActive  Boolean         @default(true) // faux = n'apparaît plus dans la liste de l'agent
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  orders    Order[]

  @@index([position])
}

// ─── Grille des frais de livraison, gérée par le Patron (src/services/delivery-fees.js) ───
// Grille vide (aucun quartier ni aucune tranche actifs) : l'équipe saisit les frais comme avant.

// Quartiers et leur prix. Jamais supprimés, seulement désactivés : les commandes gardent le nom copié.
model DeliveryZone {
  id        String   @id @default(cuid())
  name      String   @unique // « Ouaga 2000 », « Kamsonghin »…
  fee       Int // en F, de 0 (livraison offerte) à 50 000
  nightFee  Int      @default(0) // lot 3 : supplément de nuit en F (0 = aucun), ajouté pendant les heures de nuit
  position  Int      @default(0) // ordre dans la liste du client
  isActive  Boolean  @default(true) // faux = n'apparaît plus pour les clients
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]

  @@index([position])
}

// Tranches de distance à vol d'oiseau depuis le restaurant (position GPS du client). Chaque tranche va
// de la limite de la tranche active précédente jusqu'à upToMeters : ni trou ni chevauchement possible.
// Au-delà de la dernière : frais à confirmer par l'agent.
model DeliveryDistanceBand {
  id         String   @id @default(cuid())
  upToMeters Int      @unique // 3000 = jusqu'à 3 km
  fee        Int // en F, de 0 (livraison offerte) à 50 000
  nightFee   Int      @default(0) // lot 3 : supplément de nuit en F (0 = aucun)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Réglages de la grille : une seule ligne (id = 1), créée la première fois que le Patron enregistre.
// Pas de ligne = réglages par défaut : la migration n'écrit rien.
model DeliverySettings {
  id             Int      @id @default(1)
  allowOtherZone Boolean  @default(true) // option « Autre quartier » : frais confirmés par l'agent au téléphone
  // Lot 3 : heures de nuit (heure du Burkina = UTC), en minutes depuis minuit. Fin avant le début = passe minuit.
  // Éteint (par défaut) = aucun supplément de nuit, comme avant.
  nightEnabled   Boolean  @default(false)
  nightStartMin  Int      @default(1320) // 22 h
  nightEndMin    Int      @default(360) // 6 h
  updatedAt      DateTime @updatedAt
}

// Les 3 photos de la mosaïque de l'accueil (case 1 : grande à gauche, 2 et 3 : petites à droite)
model HomePhoto {
  slot          Int      @id // 1, 2 ou 3
  imageUrl      String
  imagePublicId String? // identifiant Cloudinary (vide pour les photos d'origine)
  alt           String?
  updatedAt     DateTime @updatedAt
}

// ─────────────────────────── COMMANDES ───────────────────────────

model Order {
  id        String      @id @default(cuid())
  reference String      @unique // BC-7K2Q9M, communiquée au client
  status    OrderStatus @default(PAIEMENT_A_VERIFIER)

  customerName  String
  customerPhone String // normalisé +226XXXXXXXX

  // À emporter : ni position, ni frais de livraison, ni livreur. PRETE puis LIVREE (« Retirée »).
  mode      FulfillmentMode @default(LIVRAISON)
  // Parcours court (réglage AppSettings.shortFlow) : « Paiement vérifié » a fait passer la commande de
  // PAIEMENT_A_VERIFIER directement à EN_PREPARATION, avec un seul message au client. Noté sur la commande
  // pour qu'elle garde son message si le réglage change.
  shortFlow Boolean         @default(false)

  // Lot 2 : commande saisie par un agent (appel, WhatsApp). Vide = passée par le client sur le site
  // (anciennes commandes comprises). sourceName et createdByName sont des copies figées.
  sourceId      String?
  source        OrderSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  sourceName    String?
  createdById   String?
  createdBy     StaffUser?   @relation("OrdersEntered", fields: [createdById], references: [id], onDelete: SetNull)
  createdByName String?

  paymentMethod     PaymentMethod
  paymentPayerPhone String?
  paymentReference  String? // n° de transaction mobile money

  latitude         Float?
  longitude        Float?
  locationAccuracy Int? // en mètres
  addressNote      String? // quartier et repères

  itemsTotal Int // total des plats, calculé côté serveur

  // Frais de livraison : calculés par le serveur avec la grille du Patron (quartier ou distance), ou saisis
  // par l'équipe (au moins 1 F). 0 = livraison offerte (grille seulement). Vide = pas encore saisis.
  // Le livreur part une fois les frais saisis ; le client les paie au livreur à la réception,
  // en espèces ou par mobile money au numéro marchand (choix noté à la remise).
  deliveryFee           Int?
  // Grille des frais (src/services/delivery-fees.js) : copies figées à la commande. Un prix changé
  // ensuite par le Patron ne modifie pas les commandes déjà passées.
  deliveryFeeSource     DeliveryFeeSource? // vide = anciennes commandes, ou grille vide (saisis par l'équipe)
  deliveryZoneId        String?
  deliveryZone          DeliveryZone?      @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  deliveryZoneName      String? // nom du quartier choisi par le client
  deliveryDistanceM     Int? // distance à vol d'oiseau depuis le restaurant (position GPS), en mètres
  // Lot 3 : supplément de nuit compris dans deliveryFee (figé). Vide = de jour, frais saisis sans
  // supplément, ou commande d'avant le lot 3. Toujours inférieur ou égal à deliveryFee.
  deliveryNightFee      Int?
  deliveryFeeMethod     FeePaymentMethod? // vide = pas encore payés
  // Mobile money : vérifiés par l'équipe sur le téléphone marchand (vide = à vérifier).
  // Anciennes commandes (avant le 6 octobre 2026) : frais reçus avant le départ du livreur.
  deliveryFeeVerifiedAt DateTime?
  // Espèces : remise de l'argent par le livreur au restaurant (vide = encore chez le livreur)
  cashRemittanceId      String?
  cashRemittance        CashRemittance?    @relation(fields: [cashRemittanceId], references: [id], onDelete: SetNull)

  // Livreur assigné au passage EN_LIVRAISON (remplaçable tant que la commande n'est pas livrée).
  // courierName est une copie figée, comme staffName dans l'historique.
  courierId            String?
  courier              StaffUser? @relation("Courses", fields: [courierId], references: [id], onDelete: SetNull)
  courierName          String?
  courierAssignedAt    DateTime?
  // Code de remise à 4 chiffres, créé au passage EN_LIVRAISON et envoyé au client dans le message
  // « en route ». Jamais envoyé au livreur : il le tape, l'API vérifie. Bloqué après 5 codes faux.
  // À emporter : même code (code de retrait), créé au passage PRETE et envoyé dans le message « prête » ;
  // l'agent le tape au comptoir. Jamais sur la page de suivi publique.
  deliveryCode         String?
  deliveryCodeAttempts Int        @default(0)

  items         OrderItem[]
  notifications NotificationLog[]
  statusChanges OrderStatusChange[]
  events        OrderEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Une transaction mobile money ne peut servir qu'à une seule commande
  @@unique([paymentMethod, paymentReference])
  @@index([status])
  @@index([createdAt])
  @@index([courierId, status])
  @@index([cashRemittanceId])
  @@index([customerPhone, createdAt]) // client retrouvé par son numéro (prise de commande par l'agent)
  @@index([sourceId])
}

model OrderItem {
  id            String           @id @default(cuid())
  orderId       String
  order         Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId     String?
  variant       ProductVariant?  @relation(fields: [variantId], references: [id], onDelete: SetNull)
  // Copies figées au moment de la commande
  productName   String
  productNumber Int?
  variantLabel  String?
  choice        String?
  note          String?
  unitPrice     Int
  quantity      Int
  lineTotal     Int
  drinks        OrderItemDrink[] // boissons choisies dans la formule

  @@index([orderId])
}

// Boissons choisies dans une formule, pour UNE formule : à multiplier par OrderItem.quantity.
// Ex. Family Bucket : Coca-Cola ×2, Fanta ×1, Babali ×1. name est une copie figée, comme productName.
model OrderItemDrink {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  name        String
  quantity    Int

  @@index([orderItemId])
}

// Historique des statuts : chaque changement, quand et par qui.
// staffUserId vide = action du système (création de la commande). staffName est une copie figée,
// pour garder l'historique lisible même si le compte est supprimé.
model OrderStatusChange {
  id          String       @id @default(cuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  reason      String? // motif d'annulation, ou de livraison validée sans code
  staffUserId String?
  staffUser   StaffUser?   @relation(fields: [staffUserId], references: [id], onDelete: SetNull)
  staffName   String?
  createdAt   DateTime     @default(now())

  @@index([orderId, createdAt])
}

// Historique d'une commande hors statut : frais de livraison et messages WhatsApp préparés pour le client.
// Les changements de statut restent dans OrderStatusChange.
enum OrderEventType {
  FRAIS_SAISIS // frais saisis ou modifiés (montant dans amount)
  FRAIS_RECUS // ancien fonctionnement (avant le 6 octobre 2026) : frais reçus avant le départ
  FRAIS_NON_RECUS // ancien fonctionnement : case décochée
  FRAIS_VERIFIES // frais payés par mobile money, vérifiés sur le téléphone marchand
  FRAIS_NON_VERIFIES // vérification annulée (erreur de manipulation)
  MESSAGE_PREPARE // message WhatsApp au client ouvert par un agent (messageKey)
  MESSAGE_ENVOYE // l'agent confirme avoir envoyé le message de l'étape (messageKey)
  CLIENT_APPELE // client sans WhatsApp, prévenu par appel (messageKey = message de l'étape)
  LIVREUR_ASSIGNE // livreur choisi ou remplacé (nom dans courierName)
  CODE_INCORRECT // le livreur a tapé un mauvais code de remise
  LIVRAISON_SANS_CODE // livraison validée par l'agent, client sans son code (motif dans OrderStatusChange.reason)
  FRAIS_CORRIGES // frais d'une commande corrigés par l'équipe, avec un motif (après le départ du livreur : Patron seulement)
  RETRAIT_SANS_CODE // à emporter : remise au comptoir validée par l'agent, client sans son code de retrait (motif dans OrderStatusChange.reason)
}

model OrderEvent {
  id             String         @id @default(cuid())
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type           OrderEventType
  amount         Int? // montant des frais pour FRAIS_SAISIS et FRAIS_CORRIGES (nouveau montant)
  previousAmount Int? // FRAIS_CORRIGES : montant avant la correction
  reason         String? // FRAIS_CORRIGES : motif de la correction
  courierName    String? // livreur, pour LIVREUR_ASSIGNE
  messageKey     String? // PAIEMENT_CONFIRME, FRAIS_RECUS, EN_ROUTE, LIVREE, ANNULEE (src/services/customer-messages.js)
  staffUserId    String?
  staffUser      StaffUser?     @relation(fields: [staffUserId], references: [id], onDelete: SetNull)
  staffName      String? // copie figée, comme dans OrderStatusChange
  createdAt      DateTime       @default(now())

  @@index([orderId, createdAt])
}

// Espèces des frais de livraison remises par un livreur au restaurant (bouton « Espèces remises »).
// Une remise regroupe toutes les commandes payées en espèces que le livreur avait encore sur lui.
// Les noms sont des copies figées, comme dans l'historique des commandes.
model CashRemittance {
  id             String     @id @default(cuid())
  courierId      String?
  courier        StaffUser? @relation("CashFromCourier", fields: [courierId], references: [id], onDelete: SetNull)
  courierName    String
  amount         Int // total remis, en F
  orderCount     Int
  receivedById   String?
  receivedBy     StaffUser? @relation("CashToStaff", fields: [receivedById], references: [id], onDelete: SetNull)
  receivedByName String
  orders         Order[]
  createdAt      DateTime   @default(now())

  @@index([courierId, createdAt])
  @@index([createdAt])
}

model NotificationLog {
  id                String             @id @default(cuid())
  orderId           String
  order             Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  channel           String             @default("WHATSAPP")
  recipient         String
  template          String?
  status            NotificationStatus
  providerMessageId String?
  error             String?
  createdAt         DateTime           @default(now())

  @@index([orderId])
}

// ─────────────────────────── ESPACE ÉQUIPE ───────────────────────────

enum StaffRole {
  PATRON // tout
  OPERATEUR // commandes et disponibilité des plats ; ni chiffre d'affaires, ni prix, ni menu
  LIVREUR // ses courses du jour seulement, sans aucun montant
}

model StaffUser {
  id                 String    @id @default(cuid())
  name               String
  phone              String    @unique // normalisé +226XXXXXXXX, sert d'identifiant de connexion
  role               StaffRole
  passwordHash       String // scrypt, voir src/services/staff-auth.js
  isActive           Boolean   @default(true) // faux = compte désactivé (agent parti) : plus de connexion possible
  // Vrai après la création du compte ou une réinitialisation par le Patron : le mot de passe est
  // provisoire, rien n'est accessible tant que le membre ne l'a pas remplacé par le sien.
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions          StaffSession[]
  statusChanges     OrderStatusChange[]
  orderEvents       OrderEvent[]
  pushSubscriptions PushSubscription[]
  courses           Order[]             @relation("Courses")
  cashRemitted      CashRemittance[]    @relation("CashFromCourier")
  cashReceived      CashRemittance[]    @relation("CashToStaff")
  ordersEntered     Order[]             @relation("OrdersEntered")
}

// Une ligne par appareil connecté. Le navigateur garde le jeton dans un cookie httpOnly ;
// la base n'en garde que l'empreinte (SHA-256), inutilisable si elle fuitait.
model StaffSession {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  user       StaffUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  userAgent  String?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Téléphones qui reçoivent les notifications de nouvelle commande (Web Push).
// Une ligne par téléphone (navigateur) qui a activé les alertes. Les adresses que le service
// de notification déclare mortes, ou qui échouent 5 fois de suite, sont supprimées toutes seules.
model PushSubscription {
  id            String    @id @default(cuid())
  endpoint      String    @unique // adresse d'envoi donnée par le téléphone (Google, Apple, Mozilla…)
  p256dh        String // clé de chiffrement du téléphone
  auth          String // secret du téléphone
  staffUserId   String
  staffUser     StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  userAgent     String? // pour reconnaître le téléphone (« Android · Chrome »)
  failures      Int       @default(0) // échecs d'envoi d'affilée, remis à 0 au premier succès
  lastSuccessAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([staffUserId])
}
