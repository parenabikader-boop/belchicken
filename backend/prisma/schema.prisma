// Belchicken · Phase 1 : commande en ligne
// Montants en FCFA (entiers). Fuseau de référence : Africa/Ouagadougou (UTC+0).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // URL poolée Neon
  directUrl = env("DIRECT_URL") // URL directe Neon (migrations)
}

// ─────────────────────────── ENUMS ───────────────────────────

// Parcours : PAIEMENT_A_VERIFIER -> PAYEE -> EN_PREPARATION -> EN_LIVRAISON -> LIVREE,
// ANNULEE possible à tout moment avant LIVREE. PAYEE est toujours posé à la main par l'équipe,
// après vérification sur le téléphone marchand. Règles dans src/services/order-status.js.
enum OrderStatus {
  PAIEMENT_A_VERIFIER // départ de toute nouvelle commande
  PAYEE
  EN_PREPARATION
  EN_LIVRAISON
  LIVREE
  ANNULEE
}

enum PaymentMethod {
  ORANGE_MONEY
  MOOV_MONEY
  ESPECES // refusé par l'API (plus d'espèces pour les plats), gardé pour les anciennes commandes
  TELECEL_MONEY
}

// Frais de livraison payés au livreur à la réception : comment le client les a payés
enum FeePaymentMethod {
  ESPECES // en espèces au livreur (remises ensuite au restaurant : CashRemittance)
  MOBILE_MONEY // par Orange Money / Moov Money / Telecel Money, code marchand (vérifiés par l'équipe)
}

enum NotificationStatus {
  ENVOYEE
  ECHEC
  IGNOREE // WhatsApp non configuré
}

// ─────────────────────────── MENU ───────────────────────────

model Category {
  id                String      @id @default(cuid())
  slug              String      @unique
  name              String
  description       String?
  script            String? // petit titre du bandeau, ex. "Originals & XL"
  heroImageUrl      String? // photo vedette du bandeau (Cloudinary, ou /menu/… pour les photos d'origine)
  heroImagePublicId String? // identifiant Cloudinary, pour remplacer ou supprimer la photo
  position          Int         @default(0)
  isActive          Boolean     @default(true)
  groups            MenuGroup[]
  products          Product[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

// Sous-groupe d'une catégorie (ex. Burgers › Originals, XL, Bœuf)
model MenuGroup {
  id         String    @id @default(cuid())
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String
  note       String? // ex. "N° 7 à 9"
  position   Int       @default(0)
  products   Product[]

  @@unique([categoryId, name])
}

model Product {
  id            String           @id @default(cuid())
  slug          String           @unique
  number        Int? // numéro du menu papier (N° 7…)
  name          String
  description   String?
  composition   String[] // ce qui est inclus dans une formule
  imageUrl      String?
  imagePublicId String? // identifiant Cloudinary de imageUrl (vide pour les photos d'origine)
  isSpicy       Boolean          @default(false)
  serves        String? // "2 personnes"
  choiceLabel   String? // ex. "Cuisson du poulet"
  choices       String[] // ex. ["Grillé", "Frit"]
  isAvailable   Boolean          @default(true)
  // Plat retiré du menu alors qu'il a déjà été commandé : on le garde pour l'historique des commandes.
  // Un plat jamais commandé est vraiment supprimé.
  archivedAt    DateTime?
  position      Int              @default(0)
  categoryId    String
  category      Category         @relation(fields: [categoryId], references: [id])
  groupId       String?
  group         MenuGroup?       @relation(fields: [groupId], references: [id], onDelete: SetNull)
  variants      ProductVariant[]
  orderItems    OrderItem[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([categoryId])
}

// Tout produit a au moins une variante : c'est elle qui porte le prix
// (Menu / Seul, Taille L / XL, 4 pièces / 8 pièces, ou "standard").
model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  code       String // "menu", "seul", "L", "4pc", "standard"
  label      String
  subLabel   String?
  price      Int
  position   Int         @default(0)
  orderItems OrderItem[]

  @@unique([productId, code])
}

// Les 3 photos de la mosaïque de l'accueil (case 1 : grande à gauche, 2 et 3 : petites à droite)
model HomePhoto {
  slot          Int      @id // 1, 2 ou 3
  imageUrl      String
  imagePublicId String? // identifiant Cloudinary (vide pour les photos d'origine)
  alt           String?
  updatedAt     DateTime @updatedAt
}

// ─────────────────────────── COMMANDES ───────────────────────────

model Order {
  id        String      @id @default(cuid())
  reference String      @unique // BC-7K2Q9M, communiquée au client
  status    OrderStatus @default(PAIEMENT_A_VERIFIER)

  customerName  String
  customerPhone String // normalisé +226XXXXXXXX

  paymentMethod     PaymentMethod
  paymentPayerPhone String?
  paymentReference  String? // n° de transaction mobile money

  latitude         Float?
  longitude        Float?
  locationAccuracy Int? // en mètres
  addressNote      String? // quartier et repères

  itemsTotal Int // total des plats, calculé côté serveur

  // Frais de livraison selon le quartier, saisis par l'équipe (au moins 1 F). Vide = pas encore saisis.
  // Le livreur part une fois les frais saisis ; le client les paie au livreur à la réception,
  // en espèces ou par mobile money au numéro marchand (choix noté à la remise).
  deliveryFee           Int?
  deliveryFeeMethod     FeePaymentMethod? // vide = pas encore payés
  // Mobile money : vérifiés par l'équipe sur le téléphone marchand (vide = à vérifier).
  // Anciennes commandes (avant le 6 octobre 2026) : frais reçus avant le départ du livreur.
  deliveryFeeVerifiedAt DateTime?
  // Espèces : remise de l'argent par le livreur au restaurant (vide = encore chez le livreur)
  cashRemittanceId      String?
  cashRemittance        CashRemittance?   @relation(fields: [cashRemittanceId], references: [id], onDelete: SetNull)

  // Livreur assigné au passage EN_LIVRAISON (remplaçable tant que la commande n'est pas livrée).
  // courierName est une copie figée, comme staffName dans l'historique.
  courierId            String?
  courier              StaffUser? @relation("Courses", fields: [courierId], references: [id], onDelete: SetNull)
  courierName          String?
  courierAssignedAt    DateTime?
  // Code de remise à 4 chiffres, créé au passage EN_LIVRAISON et envoyé au client dans le message
  // « en route ». Jamais envoyé au livreur : il le tape, l'API vérifie. Bloqué après 5 codes faux.
  deliveryCode         String?
  deliveryCodeAttempts Int        @default(0)

  items         OrderItem[]
  notifications NotificationLog[]
  statusChanges OrderStatusChange[]
  events        OrderEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Une transaction mobile money ne peut servir qu'à une seule commande
  @@unique([paymentMethod, paymentReference])
  @@index([status])
  @@index([createdAt])
  @@index([courierId, status])
  @@index([cashRemittanceId])
}

model OrderItem {
  id            String          @id @default(cuid())
  orderId       String
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId     String?
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  // Copies figées au moment de la commande
  productName   String
  productNumber Int?
  variantLabel  String?
  choice        String?
  note          String?
  unitPrice     Int
  quantity      Int
  lineTotal     Int

  @@index([orderId])
}

// Historique des statuts : chaque changement, quand et par qui.
// staffUserId vide = action du système (création de la commande). staffName est une copie figée,
// pour garder l'historique lisible même si le compte est supprimé.
model OrderStatusChange {
  id          String       @id @default(cuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  reason      String? // motif d'annulation, ou de livraison validée sans code
  staffUserId String?
  staffUser   StaffUser?   @relation(fields: [staffUserId], references: [id], onDelete: SetNull)
  staffName   String?
  createdAt   DateTime     @default(now())

  @@index([orderId, createdAt])
}

// Historique d'une commande hors statut : frais de livraison et messages WhatsApp préparés pour le client.
// Les changements de statut restent dans OrderStatusChange.
enum OrderEventType {
  FRAIS_SAISIS // frais saisis ou modifiés (montant dans amount)
  FRAIS_RECUS // ancien fonctionnement (avant le 6 octobre 2026) : frais reçus avant le départ
  FRAIS_NON_RECUS // ancien fonctionnement : case décochée
  FRAIS_VERIFIES // frais payés par mobile money, vérifiés sur le téléphone marchand
  FRAIS_NON_VERIFIES // vérification annulée (erreur de manipulation)
  MESSAGE_PREPARE // message WhatsApp au client ouvert par un agent (messageKey)
  MESSAGE_ENVOYE // l'agent confirme avoir envoyé le message de l'étape (messageKey)
  CLIENT_APPELE // client sans WhatsApp, prévenu par appel (messageKey = message de l'étape)
  LIVREUR_ASSIGNE // livreur choisi ou remplacé (nom dans courierName)
  CODE_INCORRECT // le livreur a tapé un mauvais code de remise
  LIVRAISON_SANS_CODE // livraison validée par l'agent, client sans son code (motif dans OrderStatusChange.reason)
}

model OrderEvent {
  id          String         @id @default(cuid())
  orderId     String
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type        OrderEventType
  amount      Int? // montant des frais pour FRAIS_SAISIS
  courierName String? // livreur, pour LIVREUR_ASSIGNE
  messageKey  String? // PAIEMENT_CONFIRME, FRAIS_RECUS, EN_ROUTE, LIVREE, ANNULEE (src/services/customer-messages.js)
  staffUserId String?
  staffUser   StaffUser?     @relation(fields: [staffUserId], references: [id], onDelete: SetNull)
  staffName   String? // copie figée, comme dans OrderStatusChange
  createdAt   DateTime       @default(now())

  @@index([orderId, createdAt])
}

// Espèces des frais de livraison remises par un livreur au restaurant (bouton « Espèces remises »).
// Une remise regroupe toutes les commandes payées en espèces que le livreur avait encore sur lui.
// Les noms sont des copies figées, comme dans l'historique des commandes.
model CashRemittance {
  id             String     @id @default(cuid())
  courierId      String?
  courier        StaffUser? @relation("CashFromCourier", fields: [courierId], references: [id], onDelete: SetNull)
  courierName    String
  amount         Int // total remis, en F
  orderCount     Int
  receivedById   String?
  receivedBy     StaffUser? @relation("CashToStaff", fields: [receivedById], references: [id], onDelete: SetNull)
  receivedByName String
  orders         Order[]
  createdAt      DateTime   @default(now())

  @@index([courierId, createdAt])
  @@index([createdAt])
}

model NotificationLog {
  id                String             @id @default(cuid())
  orderId           String
  order             Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  channel           String             @default("WHATSAPP")
  recipient         String
  template          String?
  status            NotificationStatus
  providerMessageId String?
  error             String?
  createdAt         DateTime           @default(now())

  @@index([orderId])
}

// ─────────────────────────── ESPACE ÉQUIPE ───────────────────────────

enum StaffRole {
  PATRON // tout
  OPERATEUR // commandes et disponibilité des plats ; ni chiffre d'affaires, ni prix, ni menu
  LIVREUR // ses courses du jour seulement, sans aucun montant
}

model StaffUser {
  id                 String    @id @default(cuid())
  name               String
  phone              String    @unique // normalisé +226XXXXXXXX, sert d'identifiant de connexion
  role               StaffRole
  passwordHash       String // scrypt, voir src/services/staff-auth.js
  isActive           Boolean   @default(true) // faux = compte désactivé (agent parti) : plus de connexion possible
  // Vrai après la création du compte ou une réinitialisation par le Patron : le mot de passe est
  // provisoire, rien n'est accessible tant que le membre ne l'a pas remplacé par le sien.
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions          StaffSession[]
  statusChanges     OrderStatusChange[]
  orderEvents       OrderEvent[]
  pushSubscriptions PushSubscription[]
  courses           Order[]             @relation("Courses")
  cashRemitted      CashRemittance[]    @relation("CashFromCourier")
  cashReceived      CashRemittance[]    @relation("CashToStaff")
}

// Une ligne par appareil connecté. Le navigateur garde le jeton dans un cookie httpOnly ;
// la base n'en garde que l'empreinte (SHA-256), inutilisable si elle fuitait.
model StaffSession {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  user       StaffUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  userAgent  String?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Téléphones qui reçoivent les notifications de nouvelle commande (Web Push).
// Une ligne par téléphone (navigateur) qui a activé les alertes. Les adresses que le service
// de notification déclare mortes, ou qui échouent 5 fois de suite, sont supprimées toutes seules.
model PushSubscription {
  id            String    @id @default(cuid())
  endpoint      String    @unique // adresse d'envoi donnée par le téléphone (Google, Apple, Mozilla…)
  p256dh        String // clé de chiffrement du téléphone
  auth          String // secret du téléphone
  staffUserId   String
  staffUser     StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  userAgent     String? // pour reconnaître le téléphone (« Android · Chrome »)
  failures      Int       @default(0) // échecs d'envoi d'affilée, remis à 0 au premier succès
  lastSuccessAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([staffUserId])
}
