# Serveur
PORT=3006
NODE_ENV=development
# Origines autorisées (frontend), séparées par des virgules
CORS_ORIGINS=http://localhost:5173

# Base de données Neon. Sur l'ordinateur : branche « dev » ; sur Render : branche principale (le vrai site).
# Console Neon > Connect > choisir la branche ; « Connection pooling » activé pour DATABASE_URL, désactivé pour DIRECT_URL.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# WhatsApp Cloud API (Meta). Laisser vide pour désactiver l'envoi (les commandes restent enregistrées).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Nom et langue du modèle de message approuvé par Meta
WHATSAPP_TEMPLATE_NEW_ORDER=nouvelle_commande
WHATSAPP_TEMPLATE_LANG=fr
# Numéros de l'équipe qui reçoivent l'alerte, format international, séparés par des virgules
WHATSAPP_TEAM_NUMBERS=
# Messages au client envoyés tout seuls à chaque étape de sa commande : 1 pour activer, une fois les
# modèles de src/services/customer-messages.js approuvés chez Meta. Vide = les agents les envoient
# eux-mêmes depuis le détail de la commande (bouton WhatsApp).
WHATSAPP_CUSTOMER_AUTO=
# Adresse du site public : lien de suivi envoyé au client (/suivi/BC-XXXXXX)
PUBLIC_SITE_URL=https://belchicken-six.vercel.app
# Paiement mobile money par code marchand (USSD), sans frais. MONTANT est remplacé par le montant à payer.
# Vide = codes officiels du compte ECOFOOD (voir src/config/env.js). Le site les lit par GET /api/payment.
ORANGE_MONEY_CODE=
MOOV_MONEY_CODE=
TELECEL_MONEY_CODE=
# Nom affiché sur la confirmation de paiement du client. Vide = ECOFOOD.
MERCHANT_NAME=
# Adresse du restaurant et lien Google Maps, pour le message « commande prête » (à emporter).
# Vide = « Kamsonghin, en face de Sonia Hôtel » et le lien vers le Plus Code 9F2J+V8. Jamais la boîte postale.
RESTAURANT_ADDRESS=

# Cloudinary (photos du menu et de l'accueil). Laisser vide pour désactiver l'envoi de photos.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Dossier Cloudinary où ranger les photos : belchicken-dev sur l'ordinateur, belchicken sur Render.
# Le serveur ne supprime jamais une photo rangée dans un autre dossier que le sien.
CLOUDINARY_FOLDER=belchicken-dev

# Notifications de l'équipe sur téléphone (Web Push). Laisser vide pour les désactiver.
# Créer les clés une seule fois : node -e "console.log(require('web-push').generateVAPIDKeys())"
# Mêmes clés sur l'ordinateur et sur Render n'est pas obligatoire, mais ne jamais les changer
# en ligne : chaque téléphone devrait réactiver les alertes.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Adresse https ou mailto: qui identifie l'expéditeur
VAPID_SUBJECT=https://belchicken-api.onrender.com
