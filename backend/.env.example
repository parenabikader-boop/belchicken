# Serveur
PORT=3006
NODE_ENV=development
# Origines autorisées (frontend), séparées par des virgules
CORS_ORIGINS=http://localhost:5173

# Base de données Neon. Sur l'ordinateur : branche « dev » ; sur Render : branche principale (le vrai site).
# Console Neon > Connect > choisir la branche ; « Connection pooling » activé pour DATABASE_URL, désactivé pour DIRECT_URL.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# WhatsApp Cloud API (Meta). Laisser vide pour désactiver l'envoi (les commandes restent enregistrées).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Nom et langue du modèle de message approuvé par Meta
WHATSAPP_TEMPLATE_NEW_ORDER=nouvelle_commande
WHATSAPP_TEMPLATE_LANG=fr
# Numéros de l'équipe qui reçoivent l'alerte, format international, séparés par des virgules
WHATSAPP_TEAM_NUMBERS=+22670000001

# Cloudinary (photos du menu et de l'accueil). Laisser vide pour désactiver l'envoi de photos.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Dossier Cloudinary où ranger les photos : belchicken-dev sur l'ordinateur, belchicken sur Render.
# Le serveur ne supprime jamais une photo rangée dans un autre dossier que le sien.
CLOUDINARY_FOLDER=belchicken-dev
