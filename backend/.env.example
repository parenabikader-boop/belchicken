# Serveur
PORT=3006
NODE_ENV=development
# Origines autorisées (frontend), séparées par des virgules
CORS_ORIGINS=http://localhost:5173

# Base de données Neon
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.eu-central-1.aws.neon.tech/belchicken?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/belchicken?sslmode=require"

# WhatsApp Cloud API (Meta). Laisser vide pour désactiver l'envoi (les commandes restent enregistrées).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Nom et langue du modèle de message approuvé par Meta
WHATSAPP_TEMPLATE_NEW_ORDER=nouvelle_commande
WHATSAPP_TEMPLATE_LANG=fr
# Numéros de l'équipe qui reçoivent l'alerte, format international, séparés par des virgules
WHATSAPP_TEAM_NUMBERS=+22670000001
