{
  "name": "belchicken-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API de commande en ligne Belchicken",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch-path=src src/server.js",
    "start": "node src/server.js",
    "test": "node --test test/*.test.js",
    "test:db": "node --test --test-timeout=180000 test-db/*.db.test.js",
    "postinstall": "prisma generate",
    "db:deploy": "node scripts/migrate-deploy.js",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "equipe:patron": "node scripts/create-patron.js",
    "equipe:prestataire": "node scripts/prestataire.js",
    "cloudinary:check": "node scripts/cloudinary-check.js",
    "demo:remplir": "node scripts/demo-remplir.js",
    "demo:effacer": "node scripts/demo-effacer.js",
    "demo:mot-de-passe": "node scripts/demo-mot-de-passe.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "otpauth": "^9.5.2",
    "prisma": "^6.19.3",
    "qrcode-terminal": "^0.12.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  }
}
